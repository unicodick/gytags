{
  "schemaVersion": 1,
  "id": "gutags",
  "version": "${version}",
  "name": "Gorodurodov Tags",
  "description": "Shows Gorodurodov ranks next to player names.",
  "icon": "assets/gutags/icon.png",
  "authors": ["unic"],
  "contact": {
    "sources": "https://github.com/unicodick/gutags"
  },
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": ["lol.unic.gutags.fabric.GutagsFabricClient"]
  },
  "mixins": [
    {
      "config": "gutags.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.18.6",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": ">=0.141.3"
  }
}
